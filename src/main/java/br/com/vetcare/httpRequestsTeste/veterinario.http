@baseUrl = http://localhost:8080

### Criar um novo Veterinario1
POST http://localhost:8080/api/veterinarios
Content-Type: application/json

{
  "nome": "Joao Carlos",
  "cpf": "111845666-44",
  "crmv": "crmv54687",
  "email": "joaocarlos@email.com",
  "telefone": "47 87878 1234",
  "especialidade": "CLINICO_GERAL",
  "endereco": {
    "cep": "88025-000",
    "logradouro": "Rua Santa Catarian",
    "numero": "10",
    "complemento": "",
    "cidade": "São José",
    "estado": "Santa Catarina",
    "uf": "SC"
  }
}


