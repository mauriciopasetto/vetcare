@baseUrl = http://localhost:8080

### Criar um novo Animal1
POST http://localhost:8080/api/animais
Content-Type: application/json

{
  "nome": "Rex",
  "raca": "Labrador",
  "sexo": "MACHO",
  "especie": "CANINA",
  "dataNascimento": "2020-05-10",
  "rga": "RGA123456",
  "vivo": true,
  "tutorId": 1
}

